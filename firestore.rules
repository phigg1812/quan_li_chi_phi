rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Mỗi người chỉ truy cập dữ liệu của chính mình, trong đúng các nhóm dữ liệu mà app dùng.
    match /users/{userId}/{coll}/{docId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && coll in ['expenses', 'categories', 'wallets', 'paymentMethods',
                                        'recurring', 'learningRules', 'payees', 'settings', 'backups']
                            && docId.size() <= 200
                            && request.resource.data.keys().size() <= 60;
    }
  }
}
